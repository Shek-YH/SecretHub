      "storage": "json",
      "label": { "zh-CN": "安全笔记", "en": "Secure note" },
      "fields": [
        { "key": "body", "kind": "multiline", "sensitive": true, "required": true, "maxLength": 100000, "label": { "zh-CN": "正文", "en": "Body" } }
