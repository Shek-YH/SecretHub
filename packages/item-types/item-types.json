        { "key": "pin", "kind": "digits", "sensitive": true, "required": false, "minLength": 4, "maxLength": 6, "label": { "zh-CN": "密码", "en": "PIN" } },
        { "key": "branch", "kind": "text", "sensitive": false, "required": false, "maxLength": 200, "label": { "zh-CN": "开户行", "en": "Branch" } },
        { "key": "notes", "kind": "multiline", "sensitive": false, "required": false, "maxLength": 5000, "label": { "zh-CN": "备注", "en": "Notes" } }
      ]
    },
    {
