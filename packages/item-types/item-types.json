        { "key": "env_key", "kind": "text", "sensitive": false, "required": false, "maxLength": 128, "label": { "zh-CN": "环境变量名", "en": "Environment variable" } },
        { "key": "description", "kind": "text", "sensitive": false, "required": false, "maxLength": 500, "label": { "zh-CN": "用途说明", "en": "Purpose" } }
