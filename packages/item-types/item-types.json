        { "key": "password", "kind": "secret", "sensitive": true, "required": false, "maxLength": 1024, "label": { "zh-CN": "密码", "en": "Password" } },
        { "key": "totp", "kind": "totp_secret", "sensitive": true, "required": false, "maxLength": 128, "label": { "zh-CN": "两步验证密钥", "en": "Two-step secret" } },
        { "key": "notes", "kind": "multiline", "sensitive": false, "required": false, "maxLength": 5000, "label": { "zh-CN": "备注", "en": "Notes" } }
      ]
    },
    {
