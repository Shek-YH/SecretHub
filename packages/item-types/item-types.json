      "storage": "json",
      "label": { "zh-CN": "银行卡", "en": "Bank card" },
      "fields": [
        { "key": "bank", "kind": "text", "sensitive": false, "required": true, "maxLength": 100, "label": { "zh-CN": "银行", "en": "Bank" } },
